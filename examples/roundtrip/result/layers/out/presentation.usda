#usda 1.0

over "demo_datacentre_01"
{
    over "demo_datacentre_01_Site"
    {
        over "demo_datacentre_01"
        {
            over "L00_Ground"
            {
                over "slab_roof_main"
                {
                    token visibility = "invisible"
                }

                over "rt_clg_fws_main_r_Seg_9"
                {
                    over "Geom"
                    {
                        color3f[] primvars:displayColor = [(1, 0.22, 0.015)]
                    }

                    over "Proxy"
                    {
                        token visibility = "invisible"
                    }
                }
            }

            over "L01_Office"
            {
                over "slab_roof_office"
                {
                    token visibility = "invisible"
                }

                over "wall_l1_h_010"
                {
                    over "Geom"
                    {
                        color3f[] primvars:displayColor = [(0.02, 0.75, 0.9)]
                    }

                    over "Proxy"
                    {
                        token visibility = "invisible"
                    }
                }
            }
        }
    }
}

